// Player-head quads coloured (254, id, 253) become one face of the figure.
bool skin_figure(vec3 pos, vec4 color, vec2 uv, out vec3 outPos, out vec4 outColor, out vec2 outUv) {
    ivec3 c = ivec3(round(color.rgb * 255.0));
    if (c.r != 254 || c.b != 253 || c.g >= 36) return false;
    int id = c.g;
    vec2 t = uv * 64.0;
    bool hat = t.x > 24.0;
    vec2 corner = clamp(round((t - vec2(hat ? 40.0 : 8.0, 8.0)) / 8.0), 0.0, 1.0);
    int k = id * 4 + int(corner.x) + 2 * int(corner.y);
    vec2 anchor = pos.xy - corner * 8.0;
    vec4 r = hat ? SKIN_UV_HAT[id] : SKIN_UV[id];
    outPos = vec3(anchor + (hat ? SKIN_POS_HAT[k] : SKIN_POS[k]), pos.z);
    outUv = (r.xy + corner * r.zw) / 64.0;
    outColor = vec4(vec3(SKIN_SHADE[id]), color.a);
    return true;
}

