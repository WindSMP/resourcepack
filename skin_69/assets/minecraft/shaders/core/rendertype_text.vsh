const float GOL_BODY_W[5] = float[](364.0, 542.0, 720.0, 898.0, 988.0);
const float GOL_BODY_H[5] = float[](180.0, 261.0, 342.0, 423.0, 468.0);

// GUI size in GUI px (orthographic projection of the GUI)
vec2 ws_gui_size() { return vec2(2.0 / ProjMat[0][0], 2.0 / abs(ProjMat[1][1])); }
// sizes of the duels menu (must match duels_pack.LEVELS). At 1.0 it is 384 GUI px wide and reaches
// 176 GUI px below the anchor (y 63), where everything is scaled from.
const float WS_LEVELS[5] = float[](1.0, 1.5, 2.0, 2.5, 2.75);
const float WS_BODY_W[5] = float[](364.0, 542.0, 720.0, 898.0, 988.0);       // dialog body width per level (GUI px), from duels_pack
const float WS_BODY_H[5] = float[](180.0, 261.0, 342.0, 423.0, 459.0);       // body container height per level: lines * 9 + 8 + 10
bool ws_fits(float k) { vec2 s = ws_gui_size(); return s.x >= 384.0 * k - 0.5 && s.y >= 63.0 + 176.0 * k + 2.0; }
int ws_best_level() { int best = 0; for (int i = 1; i < 5; i++) if (ws_fits(WS_LEVELS[i])) best = i; return best; }

void main() {
    vec3 pos = Position;
    vec4 color = Color;
    vec2 uv = UV0;
if (ProjMat[3][3] > 0.5) {   // GUI
    bool golDone = false;

    // ---- Goliath scenes: a title glyph past OFF carries its position and the menu size (tools/goliath_pack.py)
    vec2 golScreen = ws_gui_size();
    float golV = Position.x - golScreen.x * 0.5 - 65536.0;
    if (golV > -2000.0) {      // duels titles end at -24836 (level 4: 40000 + 700 - OFF); ours start near +100
        float golRow = floor(golV / 1024.0);
        float xr = golV - golRow * 1024.0 - 512.0;
        int golLevel = clamp(int(floor(golRow / 768.0)), 0, 4);
        golRow -= float(golLevel) * 768.0;
        ivec3 gm = ivec3(round(Color.rgb * 255.0));
        bool obj = gm.r == 254 && gm.g >= 128 && gm.g < 192;
        bool fig = gm.r == 254 && gm.b >= 200 && gm.b <= 252 && gm.g < 64;
        vec2 p = vec2(golScreen.x * 0.5 + xr, Position.y - ((obj || fig) ? 12.0 : 20.0) + golRow * 0.5);
        bool itm = (gm.r == 253 || gm.r == 252) && gm.g >= 128 && gm.g < 192;
        if (itm) {
            // an enchantable item (glint_items): placed and sized as an object, but its quad is a glyph's (y 20..28)
            float m = mod(xr, 16.0);
            float cx = (m >= 4.0 && m < 12.0) ? 1.0 : 0.0;
            float cy = (Position.y - 20.0) > 4.0 ? 1.0 : 0.0;
            float grid = floor((xr - cx * 8.0) / 16.0 + 0.5) * 16.0;
            vec2 tl = vec2(golScreen.x * 0.5 + grid + float(gm.g - 128) * 0.25, golRow * 0.5);
            p = tl + vec2(cx, cy) * float(gm.b);
            if (gm.r == 252) {
                float wave = 0.5 + 0.5 * sin(GameTime * 24000.0 * 0.15 - (cx + cy) * 1.6 - tl.x * 0.05);
                color = vec4(1.0, 1.0, 1.0, Color.a * (0.06 + 0.5 * wave * wave * wave));
            } else {
                color = vec4(1.0, 1.0, 1.0, Color.a);
            }
        }
        if (obj) {
            // An object's corner without the vertex order (not dependable on every renderer): its left edge sits on a
            // 16 GUI px grid, so the right corners are 8 past it; the top ones are at the line's top. The rest of
            // its x (quarter px) is in the green, its size in GUI px in the blue.
            float m = mod(xr, 16.0);
            float cx = (m >= 4.0 && m < 12.0) ? 1.0 : 0.0;
            // the game draws an object's quad from y 12 to 20 (a line above a glyph's): measured, 1 px higher
            float cy = (Position.y - 12.0) > 4.0 ? 1.0 : 0.0;
            float grid = floor((xr - cx * 8.0) / 16.0 + 0.5) * 16.0;
            vec2 tl = vec2(golScreen.x * 0.5 + grid + float(gm.g - 128) * 0.25, Position.y - 12.0 - cy * 8.0 + golRow * 0.5);
            p = tl + vec2(cx, cy) * float(gm.b);
            color = vec4(1.0, 1.0, 1.0, Color.a);
        }
        if (fig) {
            vec2 t = UV0 * 64.0;
            bool hat = t.x > 24.0;
            vec2 corner = clamp(round((t - vec2(hat ? 40.0 : 8.0, 8.0)) / 8.0), 0.0, 1.0);
            int k = gm.g * 4 + int(corner.x) + 2 * int(corner.y);
            vec2 anchor = p - corner * 8.0;
            float s = float(gm.b - 200) * 0.1;
            vec4 r = hat ? GSKIN_UV_HAT[gm.g] : GSKIN_UV[gm.g];
            p = anchor + s * (hat ? GSKIN_POS_HAT[k] : GSKIN_POS[k]);
            uv = (r.xy + corner * r.zw) / 64.0;
            color = vec4(vec3(GSKIN_SHADE[gm.g]), Color.a);
        }
        // the size level: everything scaled around (screen middle, y 63), as the duels menu
        float gk = WS_LEVELS[golLevel];
        vec2 ga = vec2(golScreen.x * 0.5, 63.0);
        p = ga + gk * (p - ga);
        int best = ws_best_level();
        bool windowed = golLevel == 0 && best >= 1;
        bool tooBig = golLevel > 0 && !ws_fits(gk);
        bool mark = gm.r == 254 && !obj && !fig;
        if (mark && gm.g == 246 && gm.b >= 250 && gm.b <= 252) {
            // hall picture: plain, or on a large GUI area at the normal size the framed window over a soft backdrop
            // the backdrop also lies behind a bigger size: the scaled hall alone can end above the bottom of the screen
            bool show = gm.b == 250 ? !windowed : (gm.b == 252 ? (windowed || golLevel > 0) : windowed);
            color = (show && !tooBig) ? vec4(1.0, 1.0, 1.0, Color.a) : vec4(0.0);
            if (gm.b == 252) {
                float s = max(golScreen.x / 640.0, golScreen.y / 360.0);
                vec2 p0 = ga + (p - ga) / gk;      // cover the screen independent of the menu size
                p = vec2(golScreen.x * 0.5, 0.0) + s * (p0 - vec2(golScreen.x * 0.5, 0.0));
            }
        } else if (mark && gm == ivec3(254, 245, 250)) {
            // tip at the bottom edge of the screen (sent at y 250 GUI px)
            color = windowed ? vec4(1.0, 1.0, 1.0, Color.a) : vec4(0.0);
            p.y += golScreen.y - 8.0 - 15.0 - 250.0;
        } else if (mark && gm.g == 249 && gm.b > 240 && gm.b < 245) {
            // the "bigger" icon for level n: only the one for the biggest level that fits, if bigger, pulsing
            int n = gm.b - 240;
            float pulse = 0.82 + 0.18 * sin(GameTime * 24000.0 * 0.25);
            color = (n == best && best > golLevel && !tooBig) ? vec4(vec3(pulse), Color.a) : vec4(0.0);
        } else if (mark && gm == ivec3(254, 247, 253)) {
            color = (golLevel > 0 && !tooBig) ? vec4(1.0, 1.0, 1.0, Color.a) : vec4(0.0);
        } else if (mark && gm.g == 247 && (gm.b == 251 || gm.b == 252)) {
            // too big for the window: the note and "Normal size", nothing else. The game pushes a body wider than
            // the window to x = 0 and moves a taller one up; the click areas move with it, so these too.
            color = tooBig ? vec4(1.0, 1.0, 1.0, Color.a) : vec4(0.0);
            if (tooBig) {
                float nx = (golScreen.x - (GOL_BODY_W[golLevel] + 20.0)) / 2.0;
                if (nx < 0.0) p.x += -ceil(nx);
                float ch = min(GOL_BODY_H[golLevel], golScreen.y - 38.0);
                p.y += min(63.0, golScreen.y - 5.0 - ch) - 63.0;
            }
        } else if (tooBig) color = vec4(0.0);
        pos.xy = p;
        golDone = true;
    }

    if (!golDone) {
    vec3 p2; vec4 c2; vec2 u2;
    if (skin_figure(Position, Color, UV0, p2, c2, u2)) { pos = p2; color = c2; uv = u2; }
    // Bigger sizes of the duels menu: the server shifts the title art by level * 10000 GUI px; scale it by
    // WS_LEVELS[level] around (screen centre, y 63). Marked heads in the body (254, 248, 240 + level) likewise.
    ivec3 mark = ivec3(round(Color.rgb * 255.0));
    vec2 gs = ws_gui_size();
    int level = 0;
    float dx = pos.x - gs.x * 0.5;
    if (dx > 5000.0) { level = clamp(int(round(dx / 10000.0)), 0, 4); pos.x -= float(level) * 10000.0; }
    if (mark.r == 254 && mark.g == 248 && mark.b >= 240 && mark.b < 245) { level = mark.b - 240; color = vec4(1.0, 1.0, 1.0, Color.a); }
    float k = WS_LEVELS[level];
    if (level > 0) pos.xy = vec2(gs.x * 0.5, 63.0) + k * (pos.xy - vec2(gs.x * 0.5, 63.0));
    // Background sets (254, 246, 250..252): on a large GUI area at the normal size show the soft backdrop
    // (scaled to cover the screen) and the menu window; otherwise the plain art.
    if (mark.r == 254 && mark.g == 246 && mark.b >= 250 && mark.b <= 252) {
        bool windowed = level == 0 && ws_best_level() >= 1;
        // the backdrop also lies behind a bigger size: the scaled art alone can end above the bottom of the screen
        bool show = mark.b == 250 ? !windowed : (mark.b == 252 ? (windowed || level > 0) : windowed);
        color = show ? vec4(1.0, 1.0, 1.0, Color.a) : vec4(0.0);
        if (mark.b == 252) {
            float s = max(gs.x / 640.0, gs.y / 360.0);
            vec2 p0 = level > 0 ? vec2(gs.x * 0.5, 63.0) + (pos.xy - vec2(gs.x * 0.5, 63.0)) / k : pos.xy;
            pos.xy = vec2(gs.x * 0.5, 0.0) + s * (p0 - vec2(gs.x * 0.5, 0.0));
        }
    }
    // bottom-edge hint (254, 245, 250): at the normal size when a bigger one fits; moved from its nominal
    // y (250 GUI px) to 8 px above the bottom of the screen
    if (mark == ivec3(254, 245, 250)) {
        color = (level == 0 && ws_best_level() >= 1) ? vec4(1.0, 1.0, 1.0, Color.a) : vec4(0.0);
        pos.y += gs.y - 8.0 - 15.0 - 250.0;
    }
    // "+" for level n (254, 249, 240 + n): only the one for the biggest level that fits, if that is bigger
    if (mark.r == 254 && mark.g == 249 && mark.b > 240 && mark.b < 245) {
        int n = mark.b - 240, best = ws_best_level();
        // gentle pulse so it is noticed (GameTime: 0..1 per day, 24000 ticks)
        float pulse = 0.82 + 0.18 * sin(GameTime * 24000.0 * 0.25);
        color = (n == best && best > level) ? vec4(vec3(pulse), Color.a) : vec4(0.0);
    }
    // Too big for the window: hide the whole menu, show only the message (254, 247, 251) and the reset
    // button (254, 247, 250) right over its click area, so nothing else can be clicked by mistake.
    bool tooBig = level > 0 && !ws_fits(k);
    if (mark.r == 254 && mark.g == 247 && (mark.b == 250 || mark.b == 251)) {
        color = tooBig ? vec4(1.0, 1.0, 1.0, Color.a) : vec4(0.0);
        // A body wider than the window is pushed to x = 0 by the game: (W - width) / 2 in Java ints
        // (rounds towards zero), clamped to 0. The click area of the reset button moves with it.
        float cw = WS_BODY_W[level] + 20.0;
        float nx = (gs.x - cw) / 2.0;
        if (tooBig && nx < 0.0) pos.x += -ceil(nx);
        // A body taller than the room moves up: y = min(63, H - 5 - min(content, H - 38)) (footer is 5 px
        // without a button). Measured: H 456 -> 37, H 342 -> 33.
        float ch = min(WS_BODY_H[level], gs.y - 38.0);
        if (tooBig) pos.y += min(63.0, gs.y - 5.0 - ch) - 63.0;
    }
    else if (tooBig) color = vec4(0.0);
    }
    }
    gl_Position = ProjMat * ModelViewMat * vec4(pos, 1.0);

    sphericalVertexDistance = fog_spherical_distance(pos);
    cylindricalVertexDistance = fog_cylindrical_distance(pos);
    vertexColor = color * texelFetch(Sampler2, UV2 / 16, 0);
    texCoord0 = uv;
}
